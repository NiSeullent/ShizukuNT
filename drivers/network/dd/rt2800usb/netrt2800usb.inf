[rt.ndi]
Characteristics = 0x84
*IfType = 71
*MediaType = 16
*PhysicalMediaType = 9
BusType         = 15
AddReg          = rt.reg
CopyFiles       = rt.CopyFiles

[rt.ndi.Services]
AddService = rt2800usb, 2, rt.Service, rt.EventLog

[rt.reg]
HKR, ,                   *IfType,    0x00010001, 71
HKR, ,                   *MediaType, 0x00010001, 16
HKR, ,                   *PhysicalMediaType, 0x00010001, 9
HKR, Ndi,               Service,    0, "rt2800usb"
HKR, Ndi\Interfaces,    UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces,    LowerRange, 0, "nativewifi"

[rt.CopyFiles]
rt2800usb.sys

[rt.Service]
DisplayName    = %rt.ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\rt2800usb.sys
LoadOrderGroup = NDIS

[rt.EventLog]
AddReg = rt.EventLog.Reg

[rt.EventLog.Reg]
HKR, , EventMessageFile, 0x00020000, "%%SystemRoot%%\System32\netevent.dll"
HKR, , TypesSupported,   0x00010001, 7

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
rt2800usb.sys = 1

[Strings]
LiberNT        = "LiberNT Team"
rt.DeviceDesc  = "Ralink RT2870/RT2770 802.11n USB WiFi Adapter"
rt.ServiceDesc = "LiberNT Ralink RT2800 USB WiFi Driver"
DiskName       = "LiberNT Ralink RT2800 USB WiFi Driver Installation Disk"
